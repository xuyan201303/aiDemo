{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanzo:cost-table:reference-decision:v1",
  "title": "Offline reference decision; not a production HTTP response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "MEMORY_APPLIED",
        "AI_REQUIRED",
        "REVIEW_REQUIRED",
        "READING_REQUIRED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "unit_price": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "fee_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fee_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "kind",
    "reason",
    "unit_price",
    "currency",
    "fee_id",
    "fee_name",
    "memory_version"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MEMORY_APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "fee_id": {
            "type": "string",
            "minLength": 1
          },
          "fee_name": {
            "type": "string",
            "minLength": 1
          },
          "memory_version": {
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "fee_id": {
            "type": "null"
          },
          "fee_name": {
            "type": "null"
          }
        }
      }
    }
  ]
}
